#!/command/with-contenv sh
set -eu
export HOME=/opt/data
export PATH=/opt/hermes/.venv/bin:$PATH
cd /opt/data
# Supervisor restarts this service until bootstrap has installed credentials.
if [ ! -f /opt/data/.multica/config.json ]; then
    sleep 5
    exit 0
fi
exec s6-setuidgid hermes multica daemon start --foreground --no-auto-reload --max-concurrent-tasks "${MULTICA_DAEMON_MAX_CONCURRENT_TASKS:-1}"
