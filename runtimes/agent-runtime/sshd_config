Include /etc/ssh/sshd_config.d/worker-env.conf
Port 2222
HostKey /home/worker/hostkeys/ssh_host_ed25519_key
PidFile /home/worker/sshd.pid
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
UsePAM no
AllowUsers worker
AuthorizedKeysFile /etc/ssh/authorized_keys/worker
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
AcceptEnv *
Subsystem sftp internal-sftp
