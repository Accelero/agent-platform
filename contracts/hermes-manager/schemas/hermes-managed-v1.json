  "properties": {
    "terminal": {
      "type": "object",
      "properties": {
        "backend": {"type": "string"},
        "runtime_id": {"type": ["string", "null"], "maxLength": 63}
      },
      "additionalProperties": true
    },
    "plugins": {
      "type": "object",
      "properties": {
        "enabled": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "disabled": {"type": "array", "maxItems": 64, "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
