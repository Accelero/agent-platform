{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-manager:hermes-managed:1",
  "title": "Reviewed personal Hermes managed settings",
  "x-revision": 1,
  "x-compatibleImageDigests": ["sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db"],
  "description": "Reviewed terminal and plugin policy from the pinned personal runtime. Other keys are preserved and explicitly unvalidated.",
