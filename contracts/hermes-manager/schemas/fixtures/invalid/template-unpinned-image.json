{
  "schemaVersion": 2,
  "image": "ghcr.io/hermes:latest",
  "resources": {
    "cpuMillis": 1000,
    "memoryMib": 2048
  },
  "home": {
    "source": "nvme",
    "sizeGib": 5
  },
  "mounts": {
    "workspace": {
      "mountPath": "/workspace"
    }
  },
  "defaultVolumes": {
    "workspace": {
      "source": "nvme",
      "sizeGib": 10
    }
  },
  "adminConfig": {
    "model": {
      "provider": "custom"
    }
  },
  "secrets": [
    {
      "name": "llm-key",
      "env": "OPENAI_API_KEY"
    }
  ]
}
