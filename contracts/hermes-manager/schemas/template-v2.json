{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-manager:template:2",
  "title": "TemplateDefinition",
  "description": "A Hermes template version. Storage sources and admin settings are checked by the manager against installation settings; this schema covers the shape.",
  "x-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "image", "resources", "home"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "image": { "type": "string", "maxLength": 600, "pattern": "^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuMillis", "memoryMib"],
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 10, "maximum": 64000 },
        "memoryMib": { "type": "integer", "minimum": 128, "maximum": 262144 }
      }
    },
    "home": {
      "description": "The private Hermes home at /opt/data. Always a dynamic volume; never mounted in a terminal backend.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sizeGib"],
      "properties": {
        "source": { "$ref": "#/$defs/name" },
        "sizeGib": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "mounts": {
      "description": "Volumes mounted into Hermes, by volume name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/mount" }
    },
    "defaultVolumes": {
      "description": "Volumes created for assignments that do not define them. Every name must be mounted.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/volume" }
    },
    "adminConfig": {
      "description": "Hermes settings enforced over the user's own. Never secret values.",
      "type": "object"
    },
    "secrets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/secretReference" } }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountPath"],
      "properties": {
        "mountPath": { "type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/" },
        "readOnly": { "type": "boolean" }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/name" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^/]" },
        "sizeGib": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "readOnly": { "type": "boolean" }
      }
    },
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" },
        "file": { "$ref": "#/$defs/name" }
      },
      "oneOf": [{ "required": ["env"] }, { "required": ["file"] }]
    }
  }
}
