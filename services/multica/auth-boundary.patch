 }
+
+// requireHumanUserID keeps credential administration safe when a handler is
+// called outside its router group. Auth strips client actor headers and stamps
+// the machine source from the verified credential before this check runs.
+func requireHumanUserID(w http.ResponseWriter, r *http.Request) (string, bool) {
+	if isMachineCredentialActor(r) {
+		writeError(w, http.StatusForbidden, "this endpoint is only available to human actors")
+		return "", false
+	}
+	return requireUserID(w, r)
+}
