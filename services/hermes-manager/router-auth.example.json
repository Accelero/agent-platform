{
  "installation": {
    "id": "00000000-0000-4000-8000-000000000001",
    "epoch": 1,
    "issuer": "https://sso.example.org/realms/agents"
  },
  "oidc": {
    "jwksUrl": "https://sso.example.org/realms/agents/protocol/openid-connect/certs",
    "audience": "route-api"
  },
  "session": {
    "databaseUrlFile": "/run/secrets/router-auth/database-url",
    "publicOrigin": "https://hermes.example.org",
    "otherOrigin": "https://hermes-admin.example.org",
    "clientId": "hermes-router",
    "clientSecretFile": "/run/secrets/router-auth/client-secret",
    "scopes": ["openid"],
    "revocationUrl": "https://sso.example.org/realms/agents/protocol/openid-connect/revoke",
    "encryptionKeyringFile": "/run/secrets/router-auth/keyring.json"
  },
  "public": {
    "listen": "0.0.0.0:8443",
    "certificateFile": "/run/secrets/router-auth-tls/tls.crt",
    "privateKeyFile": "/run/secrets/router-auth-tls/tls.key"
  },
  "internal": {
    "listen": "0.0.0.0:8444",
    "certificateFile": "/run/secrets/router-auth-tls/tls.crt",
    "privateKeyFile": "/run/secrets/router-auth-tls/tls.key",
    "clientCaFile": "/run/secrets/router-clients/ca.crt",
    "forwardAuthIdentity": "spiffe://agents.example.org/router-forward-auth",
    "sessionPluginIdentity": "spiffe://agents.example.org/router-plugin"
  }
}
