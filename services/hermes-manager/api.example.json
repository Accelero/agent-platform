{
  "installation": {
    "id": "00000000-0000-4000-8000-000000000001",
    "epoch": 1,
    "issuer": "https://sso.example.org/realms/agents"
  },
  "databaseUrlFile": "/run/secrets/manager/database-url",
  "oidc": {
    "jwksUrl": "https://sso.example.org/realms/agents/protocol/openid-connect/certs"
  },
  "admin": {
    "listen": "0.0.0.0:8443",
    "tls": {
      "certificateFile": "/run/secrets/manager-admin/tls.crt",
      "privateKeyFile": "/run/secrets/manager-admin/tls.key"
    },
    "audience": "manager-api",
    "allowedClients": ["manager-admin"],
    "managementClient": "manager-admin",
    "administratorRole": "platform-administrator",
    "browser": {
      "databaseUrlFile": "/run/secrets/manager-admin-session/database-url",
      "publicOrigin": "https://hermes-admin.example.org",
      "otherOrigin": "https://hermes.example.org",
      "clientId": "manager-admin",
      "clientSecretFile": "/run/secrets/manager-admin-session/client-secret",
      "scopes": ["openid"],
      "revocationUrl": "https://sso.example.org/realms/agents/protocol/openid-connect/revoke",
      "encryptionKeyringFile": "/run/secrets/manager-admin-session/keyring.json"
    }
  },
  "resolver": {
    "listen": "0.0.0.0:8444",
    "tls": {
      "certificateFile": "/run/secrets/manager-resolver/tls.crt",
      "privateKeyFile": "/run/secrets/manager-resolver/tls.key"
    },
    "clientCaFile": "/run/secrets/router-client/ca.crt",
    "serviceIdentity": "spiffe://agents.example.org/router-plugin",
    "audience": "route-api",
    "authorizedClient": "hermes-router"
  }
}
