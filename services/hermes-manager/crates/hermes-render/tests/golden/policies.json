            ]
          }
        ]
      },
      "validations": [
        {
          "expression": "has(object.spec.securityContext) && has(object.spec.securityContext.runAsNonRoot) && object.spec.securityContext.runAsNonRoot == true && has(object.spec.securityContext.runAsUser) && has(object.spec.securityContext.runAsGroup) && ((has(object.metadata.labels) && 'app.kubernetes.io/component' in object.metadata.labels && object.metadata.labels['app.kubernetes.io/component'] == 'worker') ? (object.spec.securityContext.runAsUser > 0 && object.spec.securityContext.runAsGroup > 0) : (object.spec.securityContext.runAsUser == 1000 && object.spec.securityContext.runAsGroup == 1000))",
          "message": "Hermes Pods use the data identity; worker Pods use non-root identities"
        },
        {
          "expression": "(has(object.spec.initContainers) ? object.spec.containers + object.spec.initContainers : object.spec.containers).all(c, !has(c.securityContext) || ((!has(c.securityContext.runAsUser) || c.securityContext.runAsUser == object.spec.securityContext.runAsUser) && (!has(c.securityContext.runAsGroup) || c.securityContext.runAsGroup == object.spec.securityContext.runAsGroup) && (!has(c.securityContext.runAsNonRoot) || c.securityContext.runAsNonRoot == true)))",
          "message": "containers keep the Pod's identity"
        },
        {
          "expression": "(has(object.spec.initContainers) ? object.spec.containers + object.spec.initContainers : object.spec.containers).all(c, has(c.securityContext) && c.securityContext.allowPrivilegeEscalation == false && (!has(c.securityContext.privileged) || c.securityContext.privileged == false) && has(c.securityContext.capabilities) && has(c.securityContext.capabilities.drop) && 'ALL' in c.securityContext.capabilities.drop && (!has(c.securityContext.capabilities.add) || size(c.securityContext.capabilities.add) == 0))",
          "message": "containers are unprivileged and drop every capability"
        },
        {
          "expression": "(has(object.spec.initContainers) ? object.spec.containers + object.spec.initContainers : object.spec.containers).all(c, c.image.matches('^[^@\\\\s]+@sha256:[a-f0-9]{64}$'))",
          "message": "images are pinned by digest"
        },
        {
          "expression": "!(has(object.spec.hostNetwork) && object.spec.hostNetwork) && !(has(object.spec.hostPID) && object.spec.hostPID) && !(has(object.spec.hostIPC) && object.spec.hostIPC)",
          "message": "Pods use no host namespaces"
        },
        {
          "expression": "has(object.spec.automountServiceAccountToken) && object.spec.automountServiceAccountToken == false",
          "message": "Pods carry no Kubernetes token"
        },
        {
          "expression": "!has(object.spec.volumes) || object.spec.volumes.all(v, has(v.persistentVolumeClaim) || has(v.secret) || has(v.configMap) || has(v.emptyDir) || (has(v.projected) && v.projected.sources.all(s, has(s.secret) || has(s.configMap))))",
          "message": "volumes are claims, Secrets, ConfigMaps or emptyDirs only"
        },
        {
          "expression": "!has(object.spec.ephemeralContainers) || size(object.spec.ephemeralContainers) == 0",
          "message": "no ephemeral containers"
        }
      ]
    }
