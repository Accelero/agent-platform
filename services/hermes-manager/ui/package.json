{
  "name": "hermes-manager-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.11.1",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../../../contracts/hermes-manager/openapi.yaml -o src/generated/api.ts",
    "check:generated": "npm run generate && git diff --exit-code -- src/generated/api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "build": "npm run typecheck && vite build",
    "format:check": "prettier --check src/*.ts src/*.tsx src/*.css e2e/*.ts *.html *.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
