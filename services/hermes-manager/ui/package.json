{
  "name": "hermes-manager-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.11.1",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../../../contracts/hermes-manager/openapi.yaml -o src/generated/api.ts && prettier --write src/generated/api.ts",
    "check:generated": "npm run generate && git diff --exit-code -- src/generated/api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/licenses.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{html,ts}\" \"scripts/*.mjs\"",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "generate:schemas": "node scripts/compile-schemas.mjs",
    "check:schemas": "node scripts/compile-schemas.mjs --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "8.21.3",
    "ajv": "8.20.0",
    "get-nonce": "1.0.1",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
