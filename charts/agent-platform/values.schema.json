{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "existingSecret",
    "imagePullPolicy",
    "workloads",
    "persistence",
    "configMaps",
    "images",
    "multica"
  ],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "imagePullPolicy": {
      "enum": [
        "IfNotPresent",
        "Always",
        "Never"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "runtime-manager-config",
            "multica-gateway-config",
            "hermes-gateway-config",
            "hermes-defaults"
          ]
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "size",
          "accessModes"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "existingClaim": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "accessModes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany",
                "ReadOnlyMany",
                "ReadWriteOncePod"
              ]
            }
          },
          "storageClassName": {
            "type": "string"
          },
          "volumeName": {
            "type": "string"
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "image"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "minLength": 0
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet"
            ]
          },
          "existingSecret": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "array"
          },
          "secretEnv": {
            "type": "array"
          },
          "ports": {
            "type": "array"
          },
          "persistence": {
            "type": "array"
          },
          "resources": {
            "type": "object"
          },
          "volumes": {
            "type": "array"
          },
          "sharedMemory": {
            "type": "string"
          },
          "imageKey": {
            "enum": [
              "hermes",
              "runtime-manager",
              "multica-backend"
            ]
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "hermes",
        "agent-runtime",
        "multica-backend",
        "hermes-manager"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "multica": {
      "type": "object",
      "required": [
        "publicUrl",
        "ownerEmail",
        "databaseUrl",
        "databaseCASecret",
        "maintenanceFile",
        "mailSecret",
        "mailKeys"
      ],
      "properties": {
        "mailKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "hermesManager": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "installation",
        "api",
        "controller",
        "routerAuth",
        "resources",
        "ingress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "epoch",
            "issuer"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "issuer": {
              "type": "string"
            }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "existingSecret",
            "config"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "config": {
              "type": "object"
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "existingSecret",
            "config"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "config": {
              "type": "object"
            },
            "serviceAccountName": {
              "type": "string"
            }
          }
        },
        "routerAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "existingSecret",
            "config"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "config": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "admin": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "resolver": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "execution": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "routerPublic": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "routerInternal": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
