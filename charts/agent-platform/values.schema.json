{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "existingSecret",
    "imagePullPolicy",
    "workloads",
    "persistence",
    "configMaps",
    "images",
    "runtimeManager",
    "sandbox",
    "multica",
    "hermes"
  ],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "imagePullPolicy": {
      "enum": [
        "IfNotPresent",
        "Always",
        "Never"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "propertyNames": {
        "not": {
          "enum": [
            "runtime-manager-config",
            "multica-gateway-config",
            "hermes-gateway-config",
            "hermes-defaults"
          ]
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "size",
          "accessModes"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "existingClaim": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "accessModes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany",
                "ReadOnlyMany",
                "ReadWriteOncePod"
              ]
            }
          },
          "storageClassName": {
            "type": "string"
          },
          "volumeName": {
            "type": "string"
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "image"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "minLength": 0
          },
          "kind": {
            "enum": [
              "Deployment",
              "StatefulSet"
            ]
          },
          "existingSecret": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "array"
          },
          "secretEnv": {
            "type": "array"
          },
          "ports": {
            "type": "array"
          },
          "persistence": {
            "type": "array"
          },
          "resources": {
            "type": "object"
          },
          "volumes": {
            "type": "array"
          },
          "sharedMemory": {
            "type": "string"
          },
          "imageKey": {
            "enum": [
              "hermes",
              "runtime-manager",
              "multica-backend"
            ]
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "bootstrapIngress": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "hermes",
        "runtime-manager",
        "agent-runtime",
        "multica-backend",
        "tools"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtimeManager": {
      "type": "object",
      "required": [
        "uid",
        "gid",
        "authSecret",
        "tlsSecret",
        "clients",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "gid": {
          "type": "integer",
          "minimum": 1
        },
        "authSecret": {
          "type": "string",
          "minLength": 1
        },
        "tlsSecret": {
          "type": "string",
          "minLength": 1
        },
        "clients": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "deployment",
              "tokenKey"
            ],
            "properties": {
              "deployment": {
                "type": "string",
                "minLength": 1
              },
              "tokenKey": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "config": {
          "type": "object",
          "required": [
            "deployments",
            "templates"
          ],
          "properties": {
            "lease_ttl_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "maintenance_interval_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "deployments": {
              "type": "object"
            },
            "templates": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "kubernetes"
                ],
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "kubernetes": {
                    "type": "object",
                    "required": [
                      "role",
                      "volumes",
                      "volume_mounts"
                    ],
                    "properties": {
                      "role": {
                        "type": "string",
                        "minLength": 1
                      },
                      "volumes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "name"
                          ],
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "persistentVolumeClaim": {
                              "type": "object",
                              "required": [
                                "claimName"
                              ],
                              "properties": {
                                "claimName": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "additionalProperties": false
                            },
                            "secret": {
                              "type": "object",
                              "required": [
                                "secretName",
                                "items"
                              ],
                              "properties": {
                                "secretName": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "defaultMode": {
                                  "type": "integer"
                                },
                                "items": {
                                  "type": "array",
                                  "minItems": 1,
                                  "items": {
                                    "type": "object",
                                    "required": [
                                      "key",
                                      "path"
                                    ],
                                    "properties": {
                                      "key": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "path": {
                                        "type": "string",
                                        "minLength": 1
                                      }
                                    },
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "additionalProperties": false
                            },
                            "emptyDir": {
                              "type": "object"
                            }
                          },
                          "oneOf": [
                            {
                              "required": [
                                "persistentVolumeClaim"
                              ]
                            },
                            {
                              "required": [
                                "secret"
                              ]
                            },
                            {
                              "required": [
                                "emptyDir"
                              ]
                            }
                          ],
                          "additionalProperties": false
                        }
                      },
                      "volume_mounts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "name",
                            "mountPath"
                          ],
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "mountPath": {
                              "type": "string",
                              "pattern": "^/"
                            },
                            "subPath": {
                              "type": "string",
                              "pattern": "^[^/].*$"
                            },
                            "readOnly": {
                              "type": "boolean"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "environment": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "host_aliases"
                          ]
                        },
                        {
                          "required": [
                            "service_account"
                          ]
                        }
                      ]
                    }
                  },
                  "allowed_images": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^\\S+$"
                    }
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "docker"
                      ]
                    },
                    {
                      "required": [
                        "runtime_root"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "sandbox": {
      "type": "object",
      "not": {
        "required": [
          "roles"
        ]
      },
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              }
            }
          }
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        }
      }
    },
    "multica": {
      "type": "object",
      "required": [
        "publicUrl",
        "ownerEmail",
        "databaseUrl",
        "databaseCASecret",
        "maintenanceFile",
        "mailSecret",
        "mailKeys"
      ],
      "properties": {
        "mailKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "hermes": {
      "type": "object",
      "required": [
        "dashboardUsername",
        "maxConcurrentTasks"
      ],
      "properties": {
        "maxConcurrentTasks": {
          "type": "integer",
          "minimum": 1
        },
        "dashboardAuth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "oidc"
          ],
          "properties": {
            "mode": {
              "enum": [
                "basic",
                "oidc"
              ]
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "issuer",
                "clientId",
                "publicUrl",
                "scopes",
                "clientSecretRef"
              ],
              "properties": {
                "issuer": {
                  "type": "string"
                },
                "clientId": {
                  "type": "string"
                },
                "publicUrl": {
                  "type": "string"
                },
                "scopes": {
                  "type": "string",
                  "pattern": "(^|\\s)openid(\\s|$)"
                },
                "clientSecretRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 253,
                      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9._-]+$"
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "oidc"
                  }
                }
              },
              "then": {
                "properties": {
                  "oidc": {
                    "properties": {
                      "issuer": {
                        "pattern": "^https://[^/?#@\\s]+(/[^?#\\s]*)?$"
                      },
                      "clientId": {
                        "minLength": 1,
                        "pattern": "^\\S+$"
                      },
                      "publicUrl": {
                        "pattern": "^https://[^/?#@\\s]+/?$"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "config": {
          "type": "object"
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "default",
                "custom"
              ]
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workspace": {
          "type": "object",
          "required": [
            "name",
            "slug",
            "issuePrefix"
          ]
        },
        "lifecycle": {
          "type": "object",
          "required": [
            "before",
            "after",
            "checkpoint"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "profile": {
          "type": "string",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9_-]{0,63})?$",
          "not": {
            "enum": [
              "default",
              "custom"
            ]
          }
        }
      }
    }
  }
}
