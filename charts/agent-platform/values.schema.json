{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "existingSecret",
    "imagePullPolicy",
    "workloads",
    "persistence",
    "configMaps"
  ],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "imagePullPolicy": {
      "enum": [
        "IfNotPresent",
        "Always",
        "Never"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "size",
          "accessModes"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "existingClaim": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "accessModes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany",
                "ReadOnlyMany",
                "ReadWriteOncePod"
              ]
            }
          },
          "storageClassName": {
            "type": "string"
          },
          "volumeName": {
            "type": "string"
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "image"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["Deployment", "StatefulSet"]
          },
          "existingSecret": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "array"
          },
          "secretEnv": {
            "type": "array"
          },
          "ports": {
            "type": "array"
          },
          "persistence": {
            "type": "array"
          },
          "resources": {
            "type": "object"
          },
          "volumes": {
            "type": "array"
          },
          "sharedMemory": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "bootstrapIngress": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
